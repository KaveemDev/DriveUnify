{
  "name": "driveunify",
  "version": "1.0.0",
  "private": true,
  "description": "DriveUnify - Unified Google Drive management monorepo",
  "scripts": {
    "build": "npm --prefix landing run build",
    "build:landing": "npm --prefix landing run build",
    "build:dashboard": "npm --prefix dashboard run build",
    "build:all": "npm --prefix landing run build && npm --prefix dashboard run build",
    "dev:landing": "npm --prefix landing run dev",
    "dev:dashboard": "npm --prefix dashboard run dev",
    "lint:landing": "npm --prefix landing run lint",
    "lint:dashboard": "npm --prefix dashboard run lint",
    "lint": "npm --prefix landing run lint",
    "deploy:functions": "npx firebase-tools deploy --only functions"
  }
}
